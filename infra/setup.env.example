# Settings for setting PipeMedic up in an Azure subscription and an Azure DevOps organization.
# Copy to infra/setup.env and edit. Names marked (unique) must be unique across Azure: add your own suffix.
# Do not put the Azure DevOps token here: export AZDO_PAT in your shell instead.

# --- Azure
SUBSCRIPTION="<subscription id or name>"
LOCATION="southindia"                   # VMs, storage, Function App, Key Vault
AI_LOCATION="southindia"                # must offer gpt-5-mini and text-embedding-3-small (GlobalStandard)
RG="pipemedic-rg"
STORAGE="pipemedicst12345"              # (unique) 3-24 lowercase letters and digits
FUNCTION_APP="pipemedic-api-12345"      # (unique)
KEY_VAULT="pipemedickv12345"            # (unique)
AI_ACCOUNT="pipemedic-ai-12345"         # (unique)
EMAIL_SERVICE="pipemedic-email-12345"
COMM_SERVICE="pipemedic-comm-12345"     # (unique)
EMAIL_DATA_LOCATION="India"             # where email data is kept: India, Europe, United States, ...

# --- Container test bed (optional, step 4): the weather-app is built on the runners, pushed here, and deployed to Container Apps
ACR="pipemedicweather12345"            # (unique) 5-50 lowercase letters and digits

# --- Runner VMs
RUNNER_COUNT=2
VM_PREFIX="pipemedicvm"                 # VMs are named pipemedicvm1, pipemedicvm2, ...
VM_SIZE="Standard_B2ls_v2"
ADMIN_USER="azureuser"                  # the runner scripts expect this user
AUTO_SHUTDOWN_TIME="0600"               # daily shutdown (UTC, HHMM) to save money; leave empty for none

# --- Azure DevOps
ADO_ORG="<organization name>"           # the organization must exist and you must be a Project Collection Administrator
ADO_PROJECT="pipemedic-pipes"           # created if missing; the demo pipelines go here
ADO_POOL="pipemedic-pool"               # created if missing

# --- What the agent does
NOTIFY_TO="<you@example.com>"           # where failure and pool emails go
FIX_MODE="propose"                      # off | propose | open (open = real pull requests with AI fixes)
ACT_ENABLED="0"                         # 1 = allowlisted actions (retry, clean disk, work item) really run
